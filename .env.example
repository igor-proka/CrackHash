# Сколько worker-контейнеров поднимать скриптом scripts/start.ps1.
WORKER_REPLICAS=3

# На сколько равных сообщений manager делит один запрос на взлом.
TASK_PARTITION_COUNT=10

# Совместимый таймаут из Task 1; в Task 2 задачи не теряются и переотправляются через outbox/очереди.
TASK_TIMEOUT_MS=300000

# Один unacked task на воркера снижает риск накопления тяжелых задач в памяти.
RABBITMQ_PREFETCH=1

# Внешний порт manager на хосте.
MANAGER_PORT=8082

# Внешний порт для read-only monitoring API.
MONITORING_API_PORT=8083

# Внутренний порт worker для actuator/metrics; воркеры наружу не публикуются.
WORKER_PORT=8081

MONGO_REPLICA_SET=rs0
MONGO_CACHE_SIZE_GB=0.25
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Больше ресурсов для Prometheus при k6 load tests.
PROMETHEUS_MEM_LIMIT=2g
PROMETHEUS_RETENTION_TIME=6h

# k6 manager load profile.
K6_VUS=1000
K6_DURATION=30s
K6_POLL_STATUS=true
K6_MAX_LENGTH=2
# MD5("zz")
K6_HASH=25ed1bcb423b0b7200f485fc5ff71c8e
K6_SLEEP_SECONDS=1
