        { "expr": "sum(rate(rabbitmq_queue_messages_delivered_total{queue=~\"crackhash\\\\..*\"}[1m]) or rate(rabbitmq_detailed_queue_messages_delivered_total{queue=~\"crackhash\\\\..*\"}[1m])) by (queue)", "legendFormat": "{{queue}} delivered" }
